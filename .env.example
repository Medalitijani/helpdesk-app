# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
# Required only when intentionally creating the first administrator.
# Generate a long random value and keep it private; never commit the real token.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token

# Optional email notifications (Resend)
# Create an API key in your Resend account and verify the sender domain.
RESEND_API_KEY=
MAIL_FROM=
