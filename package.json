{
  "name": "helpdesk-app",
  "version": "0.1.0",
  "description": "IT helpdesk ticketing web app (Node.js, Express, SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests public",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"public/**/*.{js,css,html}\"",
    "seed": "node src/seed.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}